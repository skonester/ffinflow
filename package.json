{
  "name": "ffinflow",
  "version": "1.4.0",
  "description": "FFmpeg Media player",
  "author": "Skonester",
  "homepage": "https://github.com/skonester/ffinflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/skonester/ffinflow.git"
  },
  "main": "out/main.js",
  "scripts": {
    "compile": "tsc",
    "start": "tsc && electron .",
    "build": "tsc && electron-builder",
    "publish": "tsc && electron-builder -p always",
    "postinstall": "node copyFFmpeg.js"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "electron-log": "^5.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7",
    "execa": "^9.6.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "mediainfo.js": "^0.3.7",
    "music-metadata": "^7.14.0",
    "srt-to-vtt": "^1.1.3",
    "subtitle": "^4.2.1",
    "webvtt-parser": "^2.2.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.9.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.ffinflow.mediaplayer",
    "productName": "ffinflow",
    "files": [
      "out/**/*",
      "index.html",
      "styles.css",
      "images/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "ffmpeg-binaries/",
        "to": "ffmpeg-binaries/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "skonester",
      "repo": "ffinflow",
      "private": false
    }
  }
}
